<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- EchelonFoundry.Aegis.Core requires FSharp.Core >= 10.1.400 and the
         Fides packages >= 10.1.401. The F# SDK would otherwise inject an older
         FSharp.Core implicitly and NuGet would report a downgrade, so the
         version is pinned here and the implicit reference is disabled in
         Directory.Build.props. -->
    <PackageVersion Include="FSharp.Core" Version="10.1.401" />
    <PackageVersion Include="EchelonFoundry.Aegis.Core" Version="1.0.0" />
    <PackageVersion Include="EchelonFoundry.Aegis.Integration.GitHub" Version="1.0.0" />
    <!-- Arca 0.2.1 and Fides 0.2.0: attested GitHub release assets in
         vendor/nuget, installed and proven by Conditor (conditor.json,
         vendor/nuget/arca.lock, vendor/nuget/fides.lock). Fides.Client is the
         WASM sign-in client; Fides.Arca bridges it to Arca's token-provider
         port. Fides.Hosting is the server side and is not referenced here. -->
    <PackageVersion Include="EchelonFoundry.Arca.Core" Version="0.2.1" />
    <PackageVersion Include="EchelonFoundry.Arca.GitHub" Version="0.2.1" />
    <PackageVersion Include="EchelonFoundry.Fides" Version="0.2.0" />
    <PackageVersion Include="EchelonFoundry.Fides.Client" Version="0.2.0" />
    <PackageVersion Include="EchelonFoundry.Fides.Arca" Version="0.2.0" />
    <!-- Limen 0.9.0's F# router (limen-fsharp, attested release asset in
         vendor/nuget, vendor/nuget/limen-fsharp.lock): the routing semantics
         Signal's routes are built on (DF-SIGNAL-2026-0003, WI-0071). -->
    <PackageVersion Include="EchelonFoundry.Limen.Routing" Version="0.9.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
