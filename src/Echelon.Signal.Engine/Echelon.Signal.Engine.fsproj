    <Compile Include="TemplateCanonical.fs" />
    <Compile Include="Drafts.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="TemplateDiff.fs" />
    <Compile Include="Publication.fs" />
    <Compile Include="Pilot.fs" />
    <Compile Include="Canonical.fs" />
    <Compile Include="UrlState.fs" />
    <Compile Include="LiveUrl.fs" />
    <Compile Include="Submission.fs" />
    <Compile Include="Import.fs" />
    <Compile Include="GenericEnvelope.fs" />
    <Compile Include="Aggregation.fs" />
    <Compile Include="Incremental.fs" />
    <Compile Include="Groups.fs" />
    <Compile Include="GroupScoring.fs" />
    <Compile Include="GroupResult.fs" />
    <Compile Include="ReportModel.fs" />
