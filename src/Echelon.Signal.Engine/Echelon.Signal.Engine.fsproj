<Project Sdk="Microsoft.NET.Sdk">

  <!-- Limen engine: the authority side of Signal's browser boundary. Pure F#:
       the assessment, its scoring, the respondent session's transitions, the
       URL answer-state codec and the view projection. No browser, network, clock or file-system access,
       and no package dependencies beyond FSharp.Core. -->

  <ItemGroup>
    <Compile Include="View.fs" />
    <Compile Include="Scoring.fs" />
    <Compile Include="Assessment.fs" />
    <Compile Include="Responses.fs" />
    <Compile Include="Primitives.fs" />
    <Compile Include="Selectors.fs" />
    <Compile Include="PrimitiveCanonical.fs" />
    <Compile Include="Keyed.fs" />
    <Compile Include="RuleModel.fs" />
    <Compile Include="ResultModel.fs" />
    <Compile Include="Template.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Instance.fs" />
    <Compile Include="Matrix.fs" />
    <Compile Include="Banking.fs" />
    <Compile Include="Timers.fs" />
    <Compile Include="Rules.fs" />
    <Compile Include="Navigation.fs" />
    <Compile Include="Findings.fs" />
    <Compile Include="RuleChecks.fs" />
    <Compile Include="Expression.fs" />
    <Compile Include="Composite.fs" />
    <Compile Include="Interpretation.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="Benchmark.fs" />
    <Compile Include="Compatibility.fs" />
    <Compile Include="PrimitiveChecks.fs" />
    <Compile Include="SurveyResult.fs" />
    <Compile Include="RuleCanonical.fs" />
    <Compile Include="ItemKeyCanonical.fs" />
