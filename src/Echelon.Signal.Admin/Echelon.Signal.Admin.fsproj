<Project Sdk="Microsoft.NET.Sdk">

  <!-- Limen engine, administrator domain: where Signal's administrator data
       lives and the rules for reading and changing it, over Arca's
       provider-neutral storage contract. Pure F#: it builds Arca operations
       and validates what Arca reads; an Arca provider (in memory for tests,
       GitHub in the application) carries them out. No browser, network,
       clock or file-system access. -->

  <ItemGroup>
    <Compile Include="Problems.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Deployment.fs" />
    <Compile Include="DatasetManifest.fs" />
    <Compile Include="Storage.fs" />
    <Compile Include="ProviderContract.fs" />
    <Compile Include="Loading.fs" />
    <Compile Include="Growth.fs" />
    <Compile Include="Access.fs" />
    <Compile Include="AdministratorRecord.fs" />
    <Compile Include="RosterStore.fs" />
    <Compile Include="Credential.fs" />
    <Compile Include="GroupRecord.fs" />
    <Compile Include="ResultRecord.fs" />
    <Compile Include="Intake.fs" />
    <Compile Include="ReportState.fs" />
    <Compile Include="ContributionIndex.fs" />
    <Compile Include="GroupLifecycle.fs" />
    <Compile Include="AdminState.fs" />
    <Compile Include="Conflicts.fs" />
    <Compile Include="Analysis.fs" />
    <Compile Include="Comparison.fs" />
    <Compile Include="Dependencies.fs" />
    <Compile Include="AnalysisState.fs" />
    <Compile Include="Visualization.fs" />
    <Compile Include="Dashboard.fs" />
    <Compile Include="Locale.fs" />
    <Compile Include="Regression.fs" />
    <Compile Include="ReportLabels.fs" />
    <Compile Include="TemplateRecord.fs" />
    <Compile Include="Disclosure.fs" />
    <Compile Include="ReportLibrary.fs" />
    <Compile Include="ReportRecord.fs" />
    <Compile Include="Audit.fs" />
    <Compile Include="Retention.fs" />
    <Compile Include="GovernanceRecord.fs" />
    <Compile Include="TemplateListing.fs" />
    <Compile Include="Authoring.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="AdminNavigation.fs" />
    <Compile Include="AdminTypes.fs" />
    <Compile Include="AdminApp.fs" />
    <Compile Include="AdminRouteView.fs" />
    <Compile Include="AuthoringView.fs" />
    <Compile Include="AdminReportView.fs" />
    <Compile Include="AdminView.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Arca.Core" />
    <PackageReference Include="EchelonFoundry.Limen.Routing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Echelon.Signal.Engine/Echelon.Signal.Engine.fsproj" />
  </ItemGroup>

</Project>
