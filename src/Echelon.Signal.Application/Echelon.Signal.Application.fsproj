<Project Sdk="Microsoft.NET.Sdk">

  <!-- Limen engine, application tier: Limen's protocol (JSON in, view out)
       and the Aegis boundary every kernel message crosses. Deterministic
       apart from the Aegis fault ids and timestamps; no browser, network or
       file access. -->

  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="Limen.fs" />
    <Compile Include="Boundary.fs" />
    <Compile Include="Wire.fs" />
    <Compile Include="Runtime.fs" />
    <Compile Include="StorageFaults.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Aegis.Core" />
    <!-- AER-002: GitHub failures are classified with Aegis's GitHub integration. -->
    <PackageReference Include="EchelonFoundry.Aegis.Integration.GitHub" />
    <PackageReference Include="EchelonFoundry.Arca.GitHub" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Echelon.Signal.Engine/Echelon.Signal.Engine.fsproj" />
    <ProjectReference Include="../Echelon.Signal.Admin/Echelon.Signal.Admin.fsproj" />
  </ItemGroup>

</Project>
