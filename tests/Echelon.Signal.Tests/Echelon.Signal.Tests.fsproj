<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Tests read JSON through indexers that are nullable by annotation;
         a missing value fails the assertion that reads it. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Support.fs" />
    <Compile Include="AssessmentTests.fs" />
    <Compile Include="SessionTests.fs" />
    <Compile Include="BoundaryTests.fs" />
    <Compile Include="FoundationsConformanceTests.fs" />
    <Compile Include="BindingAgreementTests.fs" />
    <Compile Include="GapAnalysisTests.fs" />
    <Compile Include="UrlStateTests.fs" />
    <Compile Include="LiveUrlTests.fs" />
    <Compile Include="SubmissionTests.fs" />
    <Compile Include="ImportTests.fs" />
    <Compile Include="ScoringTests.fs" />
    <Compile Include="TemplateTests.fs" />
    <Compile Include="AuthoringTests.fs" />
    <Compile Include="RulesTests.fs" />
    <Compile Include="GroupsTests.fs" />
    <Compile Include="ScoringAstTests.fs" />
    <Compile Include="KeyedTests.fs" />
    <Compile Include="PrimitivesTests.fs" />
    <Compile Include="EncodingTests.fs" />
    <Compile Include="StructureTests.fs" />
    <Compile Include="ReportingTests.fs" />
    <Compile Include="StorageTests.fs" />
    <Compile Include="ProviderTests.fs" />
    <Compile Include="LoadingTests.fs" />
    <Compile Include="AccessTests.fs" />
    <Compile Include="SignInTests.fs" />
    <Compile Include="AdminStoreTests.fs" />
    <Compile Include="DurableImportTests.fs" />
    <Compile Include="ReportStateTests.fs" />
    <Compile Include="AdminStateTests.fs" />
    <Compile Include="AdminPageTests.fs" />
    <Compile Include="AnalyticsTests.fs" />
    <Compile Include="VisualizationTests.fs" />
    <Compile Include="LimenRoutingVectors.fs" />
    <Compile Include="LimenRoutingConformanceTests.fs" />
    <Compile Include="RoutesTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="EchelonFoundry.Aegis.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Echelon.Signal.Engine/Echelon.Signal.Engine.fsproj" />
    <ProjectReference Include="../../src/Echelon.Signal.Application/Echelon.Signal.Application.fsproj" />
    <ProjectReference Include="../../src/Echelon.Signal.Admin/Echelon.Signal.Admin.fsproj" />
    <ProjectReference Include="../../src/Limen.Routing.Interim/Limen.Routing.Interim.fsproj" />
  </ItemGroup>

</Project>
